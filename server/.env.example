# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit it.

# Port the API server listens on
PORT=4000
#admin credentials
ADMIN_EMAIL = "your@email.com"
ADMIN_PASSWORD = "createpasswordforyourself"
# Frontend origin allowed by CORS (the React dev server)
CORS_ORIGIN=http://localhost:5173

# Database connection (used from Phase 4b onward, when Prisma is added)
# Local dev uses SQLite (a file); production uses PostgreSQL.
DATABASE_URL="file:./dev.db"

#personal JWT secret shhh...
# Secret used to sign JWTs. Generate a long random string; never commit the real value.
JWT_SECRET="your-long-random-secret-here"
JWT_EXPIRES_IN="2h"